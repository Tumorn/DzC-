#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    int size;
    cout << "Введите размер массива: ";
    cin >> size;

    int* arr = new int[size];
    srand(time(0));

    for (int i = 0; i < size; ++i) {
        arr[i] = rand() % 100;
    }

    for (int i = 0; i < size - 1; ++i) {
        for (int j = 0; j < size - i - 1; ++j) {
            if (arr[j] > arr[j + 1]) swap(arr[j], arr[j + 1]);
        }
    }

    for (int i = 0; i < size; ++i) {
        cout << arr[i] << " ";
    }

    delete[] arr;
    return 0;
}
