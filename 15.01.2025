// Задание 1.
#include <iostream>
using namespace std;

int* mergeArrays(int* arr1, int size1, int* arr2, int size2) {
    int* merged = new int[size1 + size2];
    for (int i = 0; i < size1; ++i) merged[i] = arr1[i];
    for (int i = 0; i < size2; ++i) merged[size1 + i] = arr2[i];
    return merged;
}


//Задание 2.
int* arrayWithMaxSum(int* arr1, int size1, int* arr2, int size2) {
    int sum1 = 0, sum2 = 0;
    for (int i = 0; i < size1; ++i) sum1 += arr1[i];
    for (int i = 0; i < size2; ++i) sum2 += arr2[i];
    return (sum1 > sum2) ? arr1 : arr2;
}
