// Задание 1.
#include <iostream>
using namespace std;

bool isSymmetric(int** matrix, int n) {
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            if (matrix[i][j] != matrix[j][i]) return false;
    return true;
}

// Задание 2.
bool areEqual(int** matrix1, int** matrix2, int n) {
    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            if (matrix1[i][j] != matrix2[i][j]) return false;
    return true;
}
